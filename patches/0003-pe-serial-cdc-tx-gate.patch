+	 * different implementations; the failure is not about the section modifier,
+	 * the callbacks, or the list position. `nabu_cdc_rx_attach` is that later
+	 * hook. It is still gated on nabu-cdc-rx (default OFF). */
+	(void)0;
 	DTEntry         entryP = NULL;
 	uint32_t        prop_size;
 	vm_offset_t     soc_base;
@@ -960,6 +1257,13 @@ serial_init(void)
 	}
