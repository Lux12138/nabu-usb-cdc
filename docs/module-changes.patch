diff --git a/tests/test_bypass.c b/tests/test_bypass.c
new file mode 100644
index 0000000..ef909e6
--- /dev/null
+++ b/tests/test_bypass.c
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: MIT
+ * Host model for the bypass-bank mapping: geometry, bank selection, the exact
+ * write set, the callback allow-list and restore.
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "soc/QcomUsbBypass.h"
+
+struct cell { QUSB_U64 address; QUSB_U32 value; };
+struct model {
+  struct cell cells[64];
+  unsigned int count, writes;
+};
+
+static struct cell *find(struct model *m, QUSB_U64 address, int create)
+{
+  unsigned int i;
+  for (i = 0; i < m->count; ++i) if (m->cells[i].address == address) return &m->cells[i];
+  if (!create) return NULL;
+  assert(m->count < 64);
+  m->cells[m->count].address = address;
+  m->cells[m->count].value = 0;
+  return &m->cells[m->count++];
+}
+static void set(struct model *m, QUSB_U64 address, QUSB_U32 value)
+{
+  find(m, address, 1)->value = value;
+}
+static QUSB_U32 get(struct model *m, QUSB_U64 address)
+{
+  return find(m, address, 1)->value;
+}
+static int read32(void *cookie, QUSB_U64 address, QUSB_U32 *value)
+{
+  *value = get(cookie, address);
+  return 1;
+}
+static int write32(void *cookie, QUSB_U64 address, QUSB_U32 value)
+{
+  struct model *m = cookie;
+  ++m->writes;
+  set(m, address, value);
+  return 1;
+}
+static void barrier(void *cookie) { (void)cookie; }
+
+static QUSB_U64 cb(unsigned int bank) { return QUSB_SMMU_BASE + (QUSB_U64)(4u + bank) * 4096u; }
+static QUSB_U64 cbar(unsigned int bank) { return QUSB_SMMU_BASE + 0x1000u + 4u * bank; }
+static QUSB_U64 cba2r(unsigned int bank) { return QUSB_SMMU_BASE + 0x1800u + 4u * bank; }
+static QUSB_U64 s2cr(unsigned int slot) { return QUSB_SMMU_BASE + 0xc00u + 4u * slot; }
+static QUSB_U64 smr(unsigned int slot) { return QUSB_SMMU_BASE + 0x800u + 4u * slot; }
+
+/* Four 4K groups, four banks: our stream on bank 3 (already the ready bypass
+ * bank), UFS on bank 1, bank 2 free but unconfigured. */
+static void init(struct model *m)
+{
+  memset(m, 0, sizeof(*m));
+  set(m, QUSB_SMMU_BASE + 0x20u, (1u << 30) | (1u << 27) | 4u);
+  set(m, QUSB_SMMU_BASE + 0x24u, (1u << 28) | 4u);
+  set(m, QUSB_SMMU_BASE + 0x28u, (1u << 12) | (2u << 4) | 2u);
+  set(m, QUSB_SMMU_BASE + 0x00u, 0u);
+  set(m, smr(0), 0x80000000u | QUSB_STREAM_ID);
+  set(m, s2cr(0), 3u);
+  set(m, smr(1), 0x80000000u | 0x200u);
+  set(m, s2cr(1), 1u);
+  set(m, cb(1), 1u);              /* UFS bank is translating */
+  set(m, cb(3), 0u);
+  set(m, cbar(3), 0x10000u);
+  set(m, cba2r(3), 1u);
+}
+
+int main(void)
+{
+  struct model m;
+  QUSB_BYPASS_LEASE l;
+
+  /* Already the configured bypass bank: plan succeeds without any write. */
+  init(&m);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbQualified);
+  assert(l.slot == 0u && l.bank == 3u && l.changed == 0u && l.active == 0u);
+  assert(QcomUsbBypassEnter(read32, write32, barrier, &m, &l) == QusbQualified);
+  assert(m.writes == 0);
+
+  /* A stale CBAR on the chosen bank is the only write, and restore puts it back. */
+  init(&m);
+  set(&m, cbar(3), 0x20000u);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbQualified);
+  assert(l.bank == 3u && l.changed == 2u && l.active == 1u);
+  assert(QcomUsbBypassWriteAllowed(&l, cbar(3), 0x10000u));
+  assert(!QcomUsbBypassWriteAllowed(&l, cbar(3), 0x20000u));
+  assert(!QcomUsbBypassWriteAllowed(&l, s2cr(0), 3u));
+  assert(QcomUsbBypassEnter(read32, write32, barrier, &m, &l) == QusbQualified);
+  assert(get(&m, cbar(3)) == 0x10000u);
+  assert(l.readback == 3u);                       /* S2CR untouched */
+  l.phase = 2u;
+  assert(QcomUsbBypassWriteAllowed(&l, cbar(3), 0x20000u));
+  assert(QcomUsbBypassRestore(read32, write32, barrier, &m, &l) == QusbQualified);
+  assert(get(&m, cbar(3)) == 0x20000u && !l.active);
+
+  /* Bank 3 taken by another stream: move to bank 2, configure it, restore. */
+  init(&m);
+  set(&m, smr(2), 0x80000000u | 0x300u);
+  set(&m, s2cr(2), 3u);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbQualified);
+  assert(l.bank == 2u && (l.changed & 8u) && l.slot == 0u);
+  assert(QcomUsbBypassEnter(read32, write32, barrier, &m, &l) == QusbQualified);
+  assert(get(&m, s2cr(0)) == 2u);
+  assert(get(&m, cb(2)) == 0u && get(&m, cbar(2)) == 0x10000u && get(&m, cba2r(2)) == 1u);
+  l.phase = 2u;
+  assert(QcomUsbBypassRestore(read32, write32, barrier, &m, &l) == QusbQualified);
+  assert(get(&m, s2cr(0)) == 3u && get(&m, cbar(2)) == 0u && get(&m, cba2r(2)) == 0u);
+
+  /* Every bank held: refuse without writing. */
+  init(&m);
+  set(&m, smr(2), 0x80000000u | 0x300u); set(&m, s2cr(2), 3u);
+  set(&m, smr(3), 0x80000000u | 0x400u); set(&m, s2cr(3), 2u);
+  set(&m, cb(0), 1u);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbNoFreeStream);
+  assert(m.writes == 0);
+
+  /* Ambiguous or shared matches and missing entries are refused. */
+  init(&m);
+  set(&m, smr(2), 0x80000000u | QUSB_STREAM_ID);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbMultipleStreams);
+  init(&m);
+  set(&m, smr(0), 0x80000000u | (0xffu << 16) | QUSB_STREAM_ID);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbSharedStream);
+  init(&m);
+  set(&m, smr(0), 0u);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbNoExplicitStream);
+
+  /* The DMA range must fit the SMMU's declared widths. */
+  init(&m);
+  assert(QcomUsbBypassPlan(read32, &m, 1ULL << 40, 32768u, &l) == QusbUnknownSmmu);
+
+  /* CLIENTPD set: the non-secure SMMU already bypasses, so nothing to change. */
+  init(&m);
+  set(&m, QUSB_SMMU_BASE + 0x00u, 1u);
+  assert(QcomUsbBypassPlan(read32, &m, 0xc7f4c000u, 32768u, &l) == QusbQualified);
+  assert(l.active == 0u && l.changed == 0u);
+
+  puts("QcomUsbBypass: plan, bank choice, allow-list, commit and restore modelled");
+  return 0;
+}
diff --git a/tests/test_inspect.c b/tests/test_inspect.c
index 9b6b54c..8720ffa 100644
--- a/tests/test_inspect.c
+++ b/tests/test_inspect.c
@@ -5,8 +5,13 @@ static unsigned seen;
 static int rd(void*c,QUSB_U64 a,QUSB_U32*v){
  (void)c; const QUSB_U32 clocks[]=QUD_GCC_CBCR_OFFSETS; *v=0;
  for(unsigned i=0;i<5;i++)if(a==QUSB_GCC_BASE+clocks[i]){seen|=1u<<i;return 1;}
+#if QUD_GDSC_LEGACY_PWR_ON
+ if(a==QUSB_GCC_BASE+QUD_GCC_GDSCR_OFFSET){*v=1u<<31;seen|=32;return 1;}
+ if(a==QUSB_GCC_BASE+QUD_GCC_CFG_GDSCR_OFFSET||a==QUSB_GCC_BASE+QUD_GCC_BCR_OFFSET)return 1;
+#else
  if(a==QUSB_GCC_BASE+QUD_GCC_CFG_GDSCR_OFFSET){*v=1u<<16;seen|=32;return 1;}
  if(a==QUSB_GCC_BASE+QUD_GCC_BCR_OFFSET||a==QUSB_GCC_BASE+QUD_GCC_GDSCR_OFFSET)return 1;
+#endif
  if(a==QUSB_DWC3_BASE+0xc120){*v=0x5533330a;seen|=64;return 1;}
  if(a>=QUSB_DWC3_BASE+0xc000&&a<QUSB_DWC3_BASE+0xc800)return 1;
  assert(0);return 0;
diff --git a/tests/test_prepare.c b/tests/test_prepare.c
new file mode 100644
index 0000000..3ab54d0
--- /dev/null
+++ b/tests/test_prepare.c
@@ -0,0 +1,217 @@
+/* SPDX-License-Identifier: MIT
+ * Host model for QcomUsbPrepare: a fake GCC/DWC3/PHY that follows the board's
+ * measured behaviour (GDSC needs SW_COLLAPSE cleared, clocks need enabling,
+ * BCR releases only on an explicit 0, CORESOFTRESET/CSFTRST latch until they
+ * are written back to 0, DSTS leaves halt after RUN_STOP while CONNECTSPD still
+ * carries the previous connection's value, GSTS reports the current mode).
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "include/QcomUsbPrepare.h"
+
+struct reg { uint64_t address; uint32_t value; };
+struct model {
+    struct reg regs[64];
+    unsigned int count;
+    uint32_t gdscr;
+    uint32_t bcr;
+    uint32_t gsts;
+    uint32_t dsts_after_run;
+    int gdsc_ready;
+    int gdsc_stuck_off;
+    int reset_stuck;
+    unsigned int core_writes;
+};
+
+static struct reg *find(struct model *m, uint64_t address, int create)
+{
+    unsigned int i;
+    for (i = 0; i < m->count; ++i) {
+        if (m->regs[i].address == address) return &m->regs[i];
+    }
+    if (!create) return NULL;
+    assert(m->count < 64);
+    m->regs[m->count].address = address;
+    m->regs[m->count].value = 0;
+    return &m->regs[m->count++];
+}
+
+static void set(struct model *m, uint64_t address, uint32_t value)
+{
+    find(m, address, 1)->value = value;
+}
+
+static uint32_t get(struct model *m, uint64_t address)
+{
+    return find(m, address, 1)->value;
+}
+
+static int is_cbcr(uint64_t address, unsigned int *index)
+{
+    static const uint32_t cbcr[] = QUD_GCC_CBCR_OFFSETS;
+    unsigned int i;
+    for (i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); ++i) {
+        if (address == QUD_GCC_BASE + cbcr[i]) {
+            *index = i;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int read32(void *cookie, uint64_t address, uint32_t *value)
+{
+    struct model *m = cookie;
+
+    if (address == QUD_GCC_BASE + QUD_GCC_GDSCR_OFFSET) {
+        *value = m->gdscr | (m->gdsc_ready ? (1u << 31) : 0u);
+        return 1;
+    }
+    if (address == QUD_GCC_BASE + QUD_GCC_BCR_OFFSET) {
+        *value = m->bcr;
+        return 1;
+    }
+    if (address == QUD_DWC3_BASE + 0xc118u /* GSTS */) {
+        *value = m->gsts;
+        return 1;
+    }
+    if (address == QUD_DWC3_BASE + 0xc110u /* GCTL */ && m->reset_stuck) {
+        *value = get(m, address) | (1u << 11);
+        return 1;
+    }
+    *value = get(m, address);
+    return 1;
+}
+
+static int write32(void *cookie, uint64_t address, uint32_t value)
+{
+    struct model *m = cookie;
+    unsigned int index;
+
+    if (address == QUD_GCC_BASE + QUD_GCC_GDSCR_OFFSET) {
+        m->gdscr = value & ~(1u << 31);
+        m->gdsc_ready = !(value & 1u) && !m->gdsc_stuck_off;
+        return 1;
+    }
+    if (address == QUD_GCC_BASE + QUD_GCC_BCR_OFFSET) {
+        m->bcr = value;
+        return 1;
+    }
+    if (is_cbcr(address, &index)) {
+        /* Enabling a branch clears CLK_OFF; gating it sets it again. */
+        uint32_t next = value & ~(1u << 31);
+        if (!(value & 1u)) next |= (1u << 31);
+        set(m, address, next);
+        return 1;
+    }
+    if (address >= QUD_DWC3_BASE) {
+        ++m->core_writes;
+    }
+    set(m, address, value);
+    if (address == QUD_DWC3_BASE + 0xc704u /* DCTL */ && (value & (1u << 31))) {
+        set(m, QUD_DWC3_BASE + 0xc70cu /* DSTS */, m->dsts_after_run);
+    }
+    return 1;
+}
+
+static void delay_us(void *cookie, uint32_t usec)
+{
+    (void)cookie;
+    (void)usec;
+}
+
+static void init(struct model *m)
+{
+    static const uint32_t cbcr[] = QUD_GCC_CBCR_OFFSETS;
+    unsigned int i;
+
+    memset(m, 0, sizeof(*m));
+    for (i = 0; i < sizeof(cbcr) / sizeof(cbcr[0]); ++i) {
+        set(m, QUD_GCC_BASE + cbcr[i], 0x80000000u);   /* CLK_OFF set */
+    }
+    m->gdscr = 1u;                                     /* SW_COLLAPSE asserted */
+    m->gdsc_ready = 0;
+    m->bcr = 1u;                                       /* reset still asserted */
+    m->gsts = 0;                                       /* CURMOD: device */
+    /* The exact value the board read after RUN on 2026-10-26: link up, speed
+     * field 0. It must not affect acceptance any more. */
+    m->dsts_after_run = 0x00102800u;
+    set(m, QUD_DWC3_BASE + 0xc120u, 0x33313130u);      /* GSNPSID */
+    set(m, QUD_DWC3_BASE + 0xc110u, 0x00001001u);      /* GCTL: host, halted */
+    set(m, QUD_DWC3_BASE + 0xc704u, 0x00000000u);      /* DCTL */
+    set(m, QUD_DWC3_BASE + 0xc70cu, 0x00400000u);      /* DSTS halted */
+    set(m, QUD_PHY_BASE + 0x58u, 0);                   /* COMMON1 */
+    set(m, QUD_PHY_BASE + 0x60u, 0);                   /* CTRL1 */
+}
+
+int main(void)
+{
+    struct model m;
+    QCOM_PREPARE_PLATFORM p;
+    QCOM_PREPARE_RESULT r;
+    uint32_t stage = 0xffffffffu, last = 0;
+
+    p.read32 = read32;
+    p.write32 = write32;
+    p.cookie = &m;
+    p.delay_us = delay_us;
+    p.deadline = 0;
+
+    init(&m);
+    r = QcomUsbPrepare(&p, &stage, &last);
+    assert(r == QPREP_OK);
+    assert(stage == QPREP_STAGE_CORE);
+    assert(!(m.gdscr & 1u));                       /* SW_COLLAPSE written as 0 */
+    assert(m.gdsc_ready);
+    assert(m.bcr == 0);                            /* released explicitly */
+    assert(get(&m, QUD_DWC3_BASE + 0xc700u) == 0u);   /* DCFG.DEVSPD = 0 = HS */
+    assert(get(&m, QUD_DWC3_BASE + 0xc70cu) == 0x00102800u);
+    assert((get(&m, QUD_DWC3_BASE + 0xc110u) & (3u << 12)) == (2u << 12));
+    assert(get(&m, QUD_DWC3_BASE + 0xc2c0u) & (1u << 17));   /* SS pipe suspended */
+    assert(!(get(&m, QUD_DWC3_BASE + 0xc200u) & ((1u << 6) | (1u << 8))));
+    assert(last == 0x00102800u);                      /* success signature: DSTS */
+    assert(get(&m, QUD_PHY_BASE + 0x58u) & (1u << 4));   /* VBUSVLDEXTSEL0 */
+    assert(get(&m, QUD_PHY_BASE + 0x60u) & 1u);          /* VBUSVLDEXT0 */
+
+    /* A reset bit that never falls is a hard failure, not a 20 ms delay. */
+    init(&m);
+    m.reset_stuck = 1;
+    r = QcomUsbPrepare(&p, &stage, &last);
+    assert(r == QPREP_CORE);
+    assert(stage == QPREP_STAGE_CORE);
+    assert(last & (1u << 11));                        /* rb shows CORESOFTRESET */
+
+    /* Acceptance is GSTS.CURMOD, so a core that reports host mode must fail
+     * even though GCTL reads back the device value that was written. */
+    init(&m);
+    m.gsts = 1;
+    r = QcomUsbPrepare(&p, &stage, &last);
+    assert(r == QPREP_CORE);
+    assert(last == 1u);
+
+    /* RUN_STOP that leaves the core halted is also a failure. */
+    init(&m);
+    m.dsts_after_run = 0x00400000u;
+    r = QcomUsbPrepare(&p, &stage, &last);
+    assert(r == QPREP_CORE);
+    assert(last & 0x00400000u);
+
+    /* Power stuck off must stop at the GDSC stage, before any core write. */
+    init(&m);
+    m.gdsc_stuck_off = 1;
+    r = QcomUsbPrepare(&p, &stage, &last);
+    assert(r == QPREP_GDSC);
+    assert(stage == QPREP_STAGE_CLOCKS);
+    assert(m.core_writes == 0);
+
+    /* Unknown core family must be refused after clocks, before the PHY. */
+    init(&m);
+    set(&m, QUD_DWC3_BASE + 0xc120u, 0x12345678u);
+    r = QcomUsbPrepare(&p, &stage, &last);
+    assert(r == QPREP_ID);
+    assert(stage == QPREP_STAGE_ID);
+
+    puts("QcomUsbPrepare: power, clocks, reset, id, PHY and device mode modelled");
+    return 0;
+}
diff --git a/tests/test_qualify.c b/tests/test_qualify.c
index 78e0294..552f174 100644
--- a/tests/test_qualify.c
+++ b/tests/test_qualify.c
@@ -56,14 +56,18 @@ static void barrier(void *cookie) { ++((struct model *)cookie)->barriers; }
 static void init(struct model *m)
 {
   memset(m, 0, sizeof(*m));
-  set(m, QUSB_GCC_BASE + 0x39008, 1U << 16);
+#if QUD_GDSC_LEGACY_PWR_ON
+  set(m, QUSB_GCC_BASE + QUD_GCC_GDSCR_OFFSET, 1U << 31);
+#else
+  set(m, QUSB_GCC_BASE + QUD_GCC_CFG_GDSCR_OFFSET, 1U << 16);
+#endif
   set(m, QUSB_DWC3_BASE + 0xc120, 0x5533330aU);
